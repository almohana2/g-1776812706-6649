# =====================================================================
# HIR-SRS-001 — أسماء المتغيرات فقط. لا تضع أسرارًا حقيقية في هذا الملف.
# انسخه إلى .env وضع القيم الحقيقية هناك (وهو مستبعد من Git).
# =====================================================================
APP_ENV=production
APP_NAME=Hydrawise Irrigation Reporting
APP_SECRET_KEY=__GENERATE_64_RANDOM_CHARS__
TZ=Asia/Muscat
REPORT_TIMEZONE=Asia/Muscat
PUBLIC_BASE_URL=https://reports.example.om

DATABASE_URL=postgresql+psycopg://hydrawise:change-me@db:5432/hydrawise

HYDRAWISE_API_BASE=https://api.hydrawise.com/api/v1/
HYDRAWISE_API_KEY=__SET_AS_SECRET__
HYDRAWISE_CONTROLLER_ID=
HYDRAWISE_HTTP_TIMEOUT_SECONDS=20
HYDRAWISE_RAW_SAMPLE_RETENTION_DAYS=90

DEFAULT_FLOW_MIN_LPM=80
DEFAULT_FLOW_LPM=140
DEFAULT_FLOW_MAX_LPM=200
PUMP_RATED_KW=4.0
PUMP_ESTIMATED_INPUT_KW=4.0
WELL_DEPTH_M=90

MONTHLY_REPORT_CRON=15 0 1 * *
DAILY_REPORT_CRON=10 0 * * *

OPENWA_ENABLED=true
OPENWA_BASE_URL=https://owa.fidanet.om
OPENWA_API_KEY=__SET_AS_SECRET__
OPENWA_SESSION_ID=__SET_AS_SECRET__
OPENWA_RECIPIENT=968XXXXXXXX
# ترويسة المصادقة وصيغة الجسم قابلتان للضبط حسب إصدار البوابة
OPENWA_AUTH_HEADER=x-api-key
OPENWA_AUTH_SCHEME=
OPENWA_SEND_PATH=/api/sessions/{session_id}/messages/send-text
OPENWA_RECIPIENT_FIELD=chatId
OPENWA_TEXT_FIELD=text
OPENWA_RECIPIENT_SUFFIX=@c.us

REPORT_PUBLIC_LINK_TTL_DAYS=40
BACKUP_RETENTION_DAYS=30
LOG_LEVEL=INFO

# حساب الإدارة الأول — يُنشأ بأمر bootstrap فقط، ولا يبقى في البيئة بعدها
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=__SET_AS_SECRET__
